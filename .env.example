# Copia este archivo como .env y cambia los dos valores antes de depurar.
MINISIEM_USERNAME=admin
MINISIEM_PASSWORD=admin
MINISIEM_SECRET_KEY=ecbe5b806ae7d7cb0e5a958831ee189d96a161284bec458d79478599366c8e25
MINISIEM_PORT=5000

# En Windows, separa varias carpetas con punto y coma (;).
# En Ubuntu, sepáralas con dos puntos (:). Incluye solo carpetas de logs propias.
MINISIEM_LOG_DIRECTORIES=C:\MiniSIEM\vm-logs

# Déjalos vacíos si no deseas notificaciones. Nunca subas .env a Git.
MINISIEM_TELEGRAM_BOT_TOKEN=
MINISIEM_TELEGRAM_CHAT_ID=
